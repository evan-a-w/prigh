; ppx_inline_test's backend with a dozen shards of files as its partitions
; (see inline_test_shards.mli) rather than one per file.

(library
 (name prigh_test_backend)
 (modules inline_test_shards)
 (libraries ppx_inline_test.runtime-lib unix)
 (inline_tests.backend
  (runner_libraries ppx_inline_test.runner.lib prigh_test_backend)
  (flags
   inline-test-runner
   %{library-name}
   -partition
   %{partition}
   -source-tree-root
   %{workspace_root}
   -diff-cmd
   -)
  (list_partitions_flags inline-test-runner %{library-name} -list-partitions)
  (generate_runner
   (echo "let () = Prigh_test_backend.Inline_test_shards.run ();;"))))

; The backend's own host by a fixed name, the same on every machine: never
; one of the tests' tool hosts ("laptop", "desktop", ...).

(env
 (_
  (env-vars
   (PRIGH_HOST_NAME <host>))))
