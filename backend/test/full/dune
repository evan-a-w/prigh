 (preprocess
  (pps ppx_jane ppx_jsonaf_conv))
 (flags
  (:standard -open Prigh_test))
 (inline_tests
  (deps ../../bin/main.exe)
  (flags
   (-source-tree-root .)))
 (libraries
  core
