  (pps ppx_jane))
 (inline_tests
  (enabled_if
   (= %{env:PRIGH_TEST_TIER=default} full))
  (flags
   (-source-tree-root .)))
 (libraries core core_unix prigh prigh_test eio eio.unix eio_main))
