agent got: {"id":1,"method":"session/new","params":{"cwd":"<tmp>","mcpServers":[]}}
agent got: {"id":2,"method":"session/prompt","params":{"prompt":[{"text":"first","type":"text"}],"sessionId":"s1"}}
agent got: {"method":"session/cancel","params":{"sessionId":"s1"}}
agent got: {"id":3,"method":"session/prompt","params":{"prompt":[{"text":"second","type":"text"}],"sessionId":"s1"}}
agent got: {"id":4,"method":"session/prompt","params":{"prompt":[{"text":"third","type":"text"}],"sessionId":"s1"}}
