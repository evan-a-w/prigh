== :PrighSessions: pick the first, its history replayed
select: prigh sessions in <tmp>
  + new session
  ● the second session · <time> · <session 2>
    the first session · <time> · <session 1>
  ->   the first session · <time> · <session 1>
→ {"id":5,"method":"session/list","params":{"cwd":"<tmp>"}}
← {"id":5,"result":{"sessions":[{"cwd":"<tmp>","sessionId":"<session 2>","title":"the second session","updatedAt":"<time>"},{"cwd":"<tmp>","sessionId":"<session 1>","title":"the first session","updatedAt":"<time>"}]}}
→ {"id":6,"method":"session/load","params":{"cwd":"<tmp>","mcpServers":[],"sessionId":"<session 1>"}}
← {"method":"session/update","params":{"sessionId":"<session 1>","update":{"kind":"execute","rawInput":{"command":"echo replayed"},"sessionUpdate":"tool_call","status":"in_progress","title":"echo replayed","toolCallId":"c1"}}}
← {"method":"session/update","params":{"sessionId":"<session 1>","update":{"content":[{"content":{"text":"```\nreplayed\n```","type":"text"},"type":"content"}],"sessionUpdate":"tool_call_update","status":"completed","toolCallId":"c1"}}}
← {"id":6,"result":{"configOptions":[{"category":"mode","currentValue":"auto","id":"mode","name":"Mode","options":[{"description":"ask before every tool that changes something","name":"Ask","value":"ask"},{"description":"edit files without asking; ask before commands","name":"Auto-edit","value":"auto-edit"},{"description":"run every tool without asking","name":"Auto","value":"auto"},{"description":"investigate and plan, changing no files, until you approve the plan","name":"Plan","value":"plan"}],"type":"select"},{"category":"model","currentValue":"deepseek/deepseek-flash","id":"model","name":"Model","options":[{"description":"deepseek/deepseek-flash","name":"DeepSeek V4.1 Flash","value":"deepseek/deepseek-flash"}],"type":"select"},{"category":"thought_level","currentValue":"on","id":"thinking","name":"Thinking","options":[{"name":"off","value":"off"},{"name":"on","value":"on"},{"name":"low","value":"low"},{"name":"high","value":"high"},{"name":"max","value":"max"}],"type":"select"}],"modes":{"availableModes":[{"description":"ask before every tool that changes something","id":"ask","name":"Ask"},{"description":"edit files without asking; ask before commands","id":"auto-edit","name":"Auto-edit"},{"description":"run every tool without asking","id":"auto","name":"Auto"},{"description":"investigate and plan, changing no files, until you approve the plan","id":"plan","name":"Plan"}],"currentModeId":"auto"}}}
