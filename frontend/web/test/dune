  test_shell
  test_skills_mcp
  test_units
  test_worktree_switch
  test_worktrees)
 (preprocess
  (pps ppx_jane js_of_ocaml-ppx))
 (inline_tests
  (backend prigh_web_test_backend)
  (modes js)
  (flags
   (-source-tree-root .)))
 (libraries
  prigh_web_test_harness
  core
  expect_test_helpers_core
  js_of_ocaml
  prigh_protocol
  prigh_web
  prigh_web_app
  virtual_dom
  virtual_dom.vdom_test_helpers
  re))

