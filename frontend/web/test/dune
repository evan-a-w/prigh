; No source map: node only reads one with --enable-source-maps.

(env
 (_
  (js_of_ocaml
   (sourcemap no))))

; full/: the slow tier, out of @runtest (see full/dune).

(vendored_dirs full)

(rule
 (alias runtest-full)
 (enabled_if %{bin-available:node})
 (deps
  (alias full/runtest))
 (action (progn)))
