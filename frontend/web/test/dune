; Runs under node (virtual_dom needs a JavaScript runtime): the state machine
; driven by actions, the page it renders as HTML, and the page glue's pure
; parts (prigh_web_app).

(library
 (name prigh_web_test)
 (enabled_if %{bin-available:node})
 (preprocess
  (pps ppx_jane js_of_ocaml-ppx))
 (inline_tests
  (modes js)
  (flags
   (-source-tree-root .)))
 (libraries
  core
  expect_test_helpers_core
  js_of_ocaml
  prigh_protocol
  prigh_web
  prigh_web_app
  virtual_dom
  virtual_dom.vdom_test_helpers
  re))

; Every test file runs in a node of its own (dune's partitions), so the
; runner's start, which is mostly parsing it, is paid a hundred times: no
; source map (node only reads one with --enable-source-maps: nearly half
; the runner), and node's compile cache, which the run listing the
; partitions fills before the partitions start. A cache it cannot write is
; skipped.

(env
 (_
  (js_of_ocaml
   (sourcemap no))
  (env-vars
   (NODE_COMPILE_CACHE /tmp/prigh-node-compile-cache))))
