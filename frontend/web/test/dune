; No source map: node only reads one with --enable-source-maps.

(env
 (_
  (js_of_ocaml
   (sourcemap no))))

; full/: the slow tier, run only with PRIGH_TEST_TIER=full (see full/dune).

(rule
 (alias runtest)
 (enabled_if %{bin-available:node})
 (deps
  (alias full/check))
 (action (progn)))
