; Run under node (virtual_dom needs a JavaScript runtime): the state machine
; driven by actions, the page it renders as HTML, and the page glue's pure
; parts (prigh_web_app).
;
; The test files are split between four libraries, each run by one node: a
; node of its own per file (dune's partitions) paid the runner's start, mostly
; parsing it, a hundred times over. The shards are balanced by the tests'
; cost; the last takes every file not listed, so a new file needs no entry.

(library
 (name prigh_web_test_harness)
 (wrapped false)
 (enabled_if %{bin-available:node})
 (modules agent_events chat_harness harness render)
 (preprocess
  (pps ppx_jane js_of_ocaml-ppx))
 (libraries
  core
  expect_test_helpers_core
  js_of_ocaml
  prigh_protocol
  prigh_web
  prigh_web_app
  virtual_dom
  virtual_dom.vdom_test_helpers
  re))

; ppx_inline_test's backend without partitions: one node runs a library's tests.

(library
 (name prigh_web_test_backend)
 (modules ())
 (inline_tests.backend
  (runner_libraries ppx_inline_test.runner.lib)
  (flags
   inline-test-runner
   %{library-name}
   -source-tree-root
   %{workspace_root}
   -diff-cmd
   -)
  (generate_runner
   (echo "let () = Ppx_inline_test_lib.exit ();;"))))

(library
 (name prigh_web_test_a)
 (enabled_if %{bin-available:node})
 (modules
  test_accounts
  test_auto_archive
  test_card
