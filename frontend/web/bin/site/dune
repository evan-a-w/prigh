(rule
 (target sw.js)
 (deps
  ../sw.template.js
  index.html
  main.bc.js
  theme.css
  style.css
  chat.css
  agents.css
  terminal.css
  files.css
  review.css
  highlight.css
  resize.css
  paging.css
  jump.css
  forge.css
  recursive-sans.woff2
  recursive-mono.woff2
  terminal.js
  xterm.js
  xterm.css
  addon-fit.js
  katex.min.js
  katex.min.css
  copy-tex.min.js
  manifest.webmanifest
  icon.svg
  icon-maskable.svg
  icon-192.png
  icon-512.png
  icon-maskable-512.png
  apple-touch-icon.png
  (glob_files KaTeX_*.woff2))
 (action
  (with-stdout-to
   sw.js
   (run %{exe:../sw_gen/sw_gen.exe} %{deps}))))

(install
 (section share)
 (package prigh_frontend)
 (files
  (index.html as web/index.html)
  (main.bc.js as web/main.bc.js)
  (theme.css as web/theme.css)
  (style.css as web/style.css)
  (chat.css as web/chat.css)
  (agents.css as web/agents.css)
  (terminal.css as web/terminal.css)
  (files.css as web/files.css)
  (review.css as web/review.css)
  (highlight.css as web/highlight.css)
  (resize.css as web/resize.css)
  (paging.css as web/paging.css)
  (jump.css as web/jump.css)
  (forge.css as web/forge.css)
  (recursive-sans.woff2 as web/recursive-sans.woff2)
  (recursive-mono.woff2 as web/recursive-mono.woff2)
  (recursive-OFL.txt as web/recursive-OFL.txt)
  (terminal.js as web/terminal.js)
  (xterm.js as web/xterm.js)
  (xterm.css as web/xterm.css)
  (addon-fit.js as web/addon-fit.js)
  (katex.min.js as web/katex.min.js)
  (katex.min.css as web/katex.min.css)
  (copy-tex.min.js as web/copy-tex.min.js)
  (LICENSE-katex as web/LICENSE-katex)
  (manifest.webmanifest as web/manifest.webmanifest)
  (icon.svg as web/icon.svg)
  (icon-maskable.svg as web/icon-maskable.svg)
  (icon-192.png as web/icon-192.png)
  (icon-512.png as web/icon-512.png)
  (icon-maskable-512.png as web/icon-maskable-512.png)
  (apple-touch-icon.png as web/apple-touch-icon.png)
  (sw.js as web/sw.js)
  (glob_files
   (KaTeX_*.woff2 with_prefix web))))
