(rule
 (target main.bc.js)
 (deps ../main.bc.js)
 (action
  (copy ../main.bc.js main.bc.js)))

; The page and its stylesheet (../app.css, all of them in one), naming the
; files they load as NAME?v=VERSION (../site_gen): the backend serves those
; as immutable, and a new build's are new names.

(rule
 (target index.html)
 (deps
  ../index.html
  app.css
  main.bc.js
  temporal-polyfill.js
  recursive-sans.woff2)
 (action
  (with-stdout-to
   index.html
   (run %{exe:../site_gen/site_gen.exe} versioned %{deps}))))

(rule
 (target app.css)
 (deps ../app.css recursive-sans.woff2 recursive-mono.woff2 inter-sans.woff2)
 (action
  (with-stdout-to
   app.css
   (run %{exe:../site_gen/site_gen.exe} versioned %{deps}))))

; Recursive (SIL OFL 1.1, recursive-OFL.txt), cut down by
; fontTools to Latin and two instances: sans (casual axis kept, for
; thinking) and mono.

(rule
 (target recursive-sans.woff2)
 (deps ../recursive-sans.woff2)
 (action
  (copy ../recursive-sans.woff2 recursive-sans.woff2)))

(rule
 (target recursive-mono.woff2)
 (deps ../recursive-mono.woff2)
 (action
  (copy ../recursive-mono.woff2 recursive-mono.woff2)))

; Inter (SIL OFL 1.1, inter-OFL.txt), for those who pick it (Theme.Font):
; InterVariable from nixpkgs' inter 4.1, cut down by fontTools' pyftsubset
; to Latin, punctuation, arrows and maths symbols, as woff2.

(rule
 (target inter-sans.woff2)
 (deps ../inter-sans.woff2)
 (action
  (copy ../inter-sans.woff2 inter-sans.woff2)))

(rule
 (target inter-OFL.txt)
 (deps ../inter-OFL.txt)
 (action
  (copy ../inter-OFL.txt inter-OFL.txt)))

(rule
 (target icons-LICENSES.txt)
 (deps ../icons-LICENSES.txt)
 (action
  (copy ../icons-LICENSES.txt icons-LICENSES.txt)))

(rule
 (target recursive-OFL.txt)
 (deps ../recursive-OFL.txt)
 (action
  (copy ../recursive-OFL.txt recursive-OFL.txt)))

; The terminal panel's xterm.js (vendored, see ../vendor/README.md) and its glue.

(rule
 (target terminal.js)
 (deps ../terminal.js)
 (action
  (copy ../terminal.js terminal.js)))

(rule
 (target xterm.js)
 (deps ../vendor/xterm.js)
 (action
  (copy ../vendor/xterm.js xterm.js)))

(rule
 (target xterm.css)
 (deps ../vendor/xterm.css)
 (action
  (copy ../vendor/xterm.css xterm.css)))

(rule
 (target addon-fit.js)
 (deps ../vendor/addon-fit.js)
 (action
  (copy ../vendor/addon-fit.js addon-fit.js)))

; The editor mode's CodeMirror (vendored, see ../vendor/README.md) and its
; glue, loaded the first time the editor opens.

(rule
 (target code_editor.js)
 (deps ../code_editor.js)
 (action
  (copy ../code_editor.js code_editor.js)))

(rule
 (target codemirror.js)
 (deps ../vendor/codemirror.js)
 (action
  (copy ../vendor/codemirror.js codemirror.js)))

; Temporal for browsers without it (index.html loads it only then): Core's
; time zones need it, and Bonsai_web's start asks for the local one.

(rule
 (target temporal-polyfill.js)
 (deps ../vendor/temporal-polyfill.js)
 (action
  (copy ../vendor/temporal-polyfill.js temporal-polyfill.js)))

; KaTeX (vendored, see ../vendor/README.md), loaded the first time math is
; shown: its script, stylesheet, copy-tex and fonts.

(copy_files
 (files ../vendor/katex/*))

; Installing it as an app (README.md, "In a browser"): the manifest, its icons
; and the service worker, which keeps the shell for offline launches.

(rule
 (target manifest.webmanifest)
 (deps ../manifest.webmanifest)
 (action
  (copy ../manifest.webmanifest manifest.webmanifest)))

