; Recursive (SIL OFL 1.1, recursive-OFL.txt), cut down by
; fontTools to Latin and two instances: sans (casual axis kept, for
; thinking) and mono.

(rule
 (target recursive-sans.woff2)
 (deps ../recursive-sans.woff2)
 (action
  (copy ../recursive-sans.woff2 recursive-sans.woff2)))

(rule
 (target recursive-mono.woff2)
 (deps ../recursive-mono.woff2)
 (action
  (copy ../recursive-mono.woff2 recursive-mono.woff2)))

