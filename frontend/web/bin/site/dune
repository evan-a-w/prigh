; KaTeX (vendored, see ../vendor/README.md), loaded the first time math is
; shown: its script, stylesheet, copy-tex and fonts.

(copy_files
 (files ../vendor/katex/*))

; Installing it as an app (README.md, "In a browser"): the manifest, its icons
; and the service worker, which keeps the shell for offline launches.

(rule
 (target manifest.webmanifest)
 (deps ../manifest.webmanifest)
 (action
  (copy ../manifest.webmanifest manifest.webmanifest)))

