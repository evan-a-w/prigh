; e2e needs only the client: in a stanza of its own it does not relink when
; the UI libraries change.

(executable
 (name e2e)
 (modules e2e)
 (preprocess
  (pps ppx_jane))
 (libraries
  core
  core_unix
  core_unix.command_unix
  core_unix.filename_unix
  core_unix.signal_unix
  re
  async
  prigh_protocol
  prigh_client
  prigh_client_unix))

; The backend these tests run is built in another dune project, so dune cannot
; see it: backend.digest is its hash (of $PRIGH_BACKEND, else the backend's
; dune build), read on every build. The tests depend on the file, so they run
; again when the backend changes and only then (early cutoff), and the shared
; cache cannot hand back a result made with another backend.

(rule
 (targets backend.digest)
 (deps (universe))
 (action
  (with-stdout-to
   backend.digest
   (run
    sh
    -c
    "b=\"${PRIGH_BACKEND:-$DUNE_SOURCEROOT/../backend/_build/default/bin/main.exe}\"; if [ -f \"$b\" ]; then sha256sum < \"$b\" | cut -c1-64; else echo \"no backend at $b\"; fi"))))

; Runs the real backend (`main.exe serve -faux`, built in the vanilla switch)
; through the real client and compares the normalised transcript.

(rule
 (aliases e2e runtest)
 (deps e2e.expected backend.digest)
 (action
  (progn
   (with-stdout-to
    e2e.actual
    (run %{exe:e2e.exe}))
   (diff e2e.expected e2e.actual))))
