; e2e needs only the client: in a stanza of its own it does not relink when
; the UI libraries change.

(executable
 (name e2e)
 (modules e2e)
 (preprocess
  (pps ppx_jane))
 (libraries
  core
  core_unix
  core_unix.command_unix
  core_unix.filename_unix
  core_unix.signal_unix
  re
  async
  prigh_protocol
  prigh_client
  prigh_client_unix))

(executable
 (name e2e_websocket)
 (modules e2e_websocket)
 (preprocess
  (pps ppx_jane))
 (libraries
  core
  core_unix
  core_unix.command_unix
  core_unix.filename_unix
  core_unix.signal_unix
  re
  async
  prigh_protocol
  prigh_client
  prigh_client_unix
  prigh_client_unix_testing
  prigh_ui
  prigh_tui))

; Runs the real backend (`main.exe serve -faux`, built in the vanilla switch)
; through the real client and compares the normalised transcript. The backend
; is built in another dune project: PRIGH_BACKEND_DIGEST (./test sets it to
; the binary's hash) runs these again when it changes, and only then.

(rule
 (aliases e2e runtest)
 (deps
  e2e.expected
  (env_var PRIGH_BACKEND_DIGEST))
 (action
  (progn
   (with-stdout-to
    e2e.actual
    (run %{exe:e2e.exe}))
   (diff e2e.expected e2e.actual))))

; The same backend's -web port over ws://, and wss:// through a TLS proxy: in
; @runtest-full (./test --full), as relinking it on every change to the UI
; libraries cost more than running it; the browser smoke test uses ws://.

(rule
 (aliases e2e runtest-full)
 (deps
  e2e_websocket.expected
  (env_var PRIGH_BACKEND_DIGEST))
 (action
  (progn
   (with-stdout-to
    e2e_websocket.actual
    (run %{exe:e2e_websocket.exe}))
   (diff e2e_websocket.expected e2e_websocket.actual))))
