#!/usr/bin/env bash
# Builds the backend and the frontends (OxCaml: the `prigh-ox` opam switch,
# or the current environment under `nix develop`), then runs the TUI.
# Usage: ./prigh [frontend options] [-- backend options]   (see prigh-tui -help)
#        ./prigh -web [serve options]                      (prigh-web, the browser frontend; see prigh serve -help)
set -euo pipefail
root="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
export PATH="$HOME/.local/bin:$PATH"

if [ -z "${IN_NIX_SHELL:-}" ] && command -v opam >/dev/null; then
	eval "$(opam env --switch=prigh-ox --set-switch)"
fi
(cd "$root/backend" && dune build 2>&1)

export PRIGH_BACKEND="${PRIGH_BACKEND:-$root/backend/_build/default/bin/main.exe}"

# ./prigh -web [serve options]: prigh-web (frontend/web/) instead of the TUI.
if [ "${1:-}" = "-web" ]; then
	shift
	(cd "$root/frontend" && dune build ./web/bin/site 2>&1 | { grep -v missing-effects-backend || true; })
	export PRIGH_WEB_ROOT="${PRIGH_WEB_ROOT:-$root/frontend/_build/default/web/bin/site}"
	exec "$PRIGH_BACKEND" serve -web "${PRIGH_WEB_LISTEN:-127.0.0.1:7788}" -open "$@"
fi

(cd "$root/frontend" && dune build ./tui/bin/main.exe 2>&1)

exec "$root/frontend/_build/default/tui/bin/main.exe" "$@"
