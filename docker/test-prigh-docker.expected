exec setpriv --reuid=1000 --regid=1000 --init-groups env -u PRIGH_TOKEN -u PRIGH_GH_TOKENS -u PRIGH_HOST_TOKENS -u GH_TOKEN -u PRIGH_TOKENS -u PRIGH_SUPERUSERS HOME=/home/prigh USER=prigh LOGNAME=prigh SHELL=/bin/bash NIX_REMOTE=daemon PATH=/home/prigh/.nix-profile/bin:/home/prigh/.local/state/nix/profile/bin:$PATH PRIGH_NIX_GC_HELPER=/run/prigh/nix-gc PRIGH_TOKENS=alice=tok-a\,bob=tok-b PRIGH_HOST_TOKENS=alice=host-token-alice\,bob=host-token-bob PRIGH_SUPERUSERS=alice prigh serve -cwd /home/prigh -no-backend-host -web 0.0.0.0:7790 -model m
