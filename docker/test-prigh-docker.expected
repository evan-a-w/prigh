=== commands in the running container (docker compose exec)
$ prigh-docker users
NAME             UID    HOME                   WORKSPACE                    SUPERUSER
alice            10000  /home/alice            /workspace/alice             yes
bob              10001  /home/bob              /workspace/bob               no
$ prigh-docker as alice env
exec setpriv --reuid=10000 --regid=10000 --init-groups env -i HOME=/home/alice USER=alice LOGNAME=alice SHELL=/bin/bash NIX_REMOTE=daemon PATH=/home/alice/.nix-profile/bin:/home/alice/.local/state/nix/profile/bin:$PATH LANG=C.UTF-8 GIT_TERMINAL_PROMPT=0 env
$ TERM=xterm prigh-docker as alice env
