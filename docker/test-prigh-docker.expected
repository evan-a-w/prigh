=== uids from existing directories
$ PRIGH_TOKENS=alice=a,bob=b,carol=c,dave=d,erin=e PRIGH_NO_BACKEND_HOST=1 prigh-docker 
+ chmod 700 /home/prigh
prigh-docker: /home/alice is owned by uid 1000, not 10001: chowning it recursively
+ chown -R 10001:10001 /home/alice
+ chmod 700 /home/alice
+ chown -R 10001:10001 /workspace/alice
+ setpriv --reuid=10001 --regid=10001 --clear-groups chmod 2770 /workspace/alice
+ chown -R 10007:10007 /home/bob
+ chmod 700 /home/bob
+ setpriv --reuid=10007 --regid=10007 --clear-groups chmod 2770 /workspace/bob
prigh-docker: /home/carol is owned by uid 65534, not 10002: chowning it recursively
+ chown -R 10002:10002 /home/carol
+ chmod 700 /home/carol
+ chown -R 10002:10002 /workspace/carol
+ setpriv --reuid=10002 --regid=10002 --clear-groups chmod 2770 /workspace/carol
+ chmod 700 /home/dave
+ setpriv --reuid=10003 --regid=10003 --clear-groups chmod 2770 /workspace/dave
