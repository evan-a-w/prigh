
=== fresh volumes: two users, alice a superuser, per-user and shared GitHub tokens
$ PRIGH_TOKENS= alice=tok-a , bob=tok-b PRIGH_SUPERUSERS=alice PRIGH_GH_TOKENS=bob=gh-b GH_TOKEN=gh-shared PRIGH_GIT_NAME=Ada L PRIGH_GIT_EMAIL=ada@example.com PRIGH_ARGS=-model m prigh-docker 
+ chmod 700 /home/prigh
+ chown -R 10000:10000 /home/alice
+ chmod 700 /home/alice
+ chown -R 10000:10000 /workspace/alice
+ setpriv --reuid=10000 --regid=10000 --clear-groups chmod 2770 /workspace/alice
+ chown -R 10001:10001 /home/bob
+ chmod 700 /home/bob
+ chown -R 10001:10001 /workspace/bob
+ setpriv --reuid=10001 --regid=10001 --clear-groups chmod 2770 /workspace/bob
+ nix-store --check-validity --print-invalid <the 3 paths in /opt/nix-seed/store>
prigh-docker: adding the image's store paths to /nix (3 missing or unregistered)
+ nix-store --load-db < /opt/nix-seed/registration
supervise nix-daemon: env -i PATH=$PATH LANG=C.UTF-8 HOME=/root XDG_CACHE_HOME=/nix/var/cache/root nix-daemon --quiet
+ setpriv --reuid=10000 --regid=10000 --init-groups env -i HOME=/home/alice USER=alice LOGNAME=alice SHELL=/bin/bash NIX_REMOTE=daemon PATH=/home/alice/.nix-profile/bin:/home/alice/.local/state/nix/profile/bin:$PATH LANG=C.UTF-8 GIT_TERMINAL_PROMPT=0 GH_TOKEN=gh-shared sh -c $'for kv in "user.name=$1" "user.email=$2"; do\n  [ -z "${kv#*=}" ] || git config --global --get "${kv%%=*}" >/dev/null || git config --global "${kv%%=*}" "${kv#*=}"\ndone' sh Ada\ L ada@example.com
+ setpriv --reuid=10001 --regid=10001 --init-groups env -i HOME=/home/bob USER=bob LOGNAME=bob SHELL=/bin/bash NIX_REMOTE=daemon PATH=/home/bob/.nix-profile/bin:/home/bob/.local/state/nix/profile/bin:$PATH LANG=C.UTF-8 GIT_TERMINAL_PROMPT=0 GH_TOKEN=gh-b sh -c $'for kv in "user.name=$1" "user.email=$2"; do\n  [ -z "${kv#*=}" ] || git config --global --get "${kv%%=*}" >/dev/null || git config --global "${kv%%=*}" "${kv#*=}"\ndone' sh Ada\ L ada@example.com
supervise in /workspace/alice: setpriv --reuid=10000 --regid=10000 --init-groups env -i HOME=/home/alice USER=alice LOGNAME=alice SHELL=/bin/bash NIX_REMOTE=daemon PATH=/home/alice/.nix-profile/bin:/home/alice/.local/state/nix/profile/bin:$PATH LANG=C.UTF-8 GIT_TERMINAL_PROMPT=0 GH_TOKEN=gh-shared PRIGH_TOKEN=host-token-alice PRIGH_USER=alice prigh tool-host -connect 127.0.0.1:7788 -name container -cwd /workspace/alice
supervise in /workspace/bob: setpriv --reuid=10001 --regid=10001 --init-groups env -i HOME=/home/bob USER=bob LOGNAME=bob SHELL=/bin/bash NIX_REMOTE=daemon PATH=/home/bob/.nix-profile/bin:/home/bob/.local/state/nix/profile/bin:$PATH LANG=C.UTF-8 GIT_TERMINAL_PROMPT=0 GH_TOKEN=gh-b PRIGH_TOKEN=host-token-bob PRIGH_USER=bob prigh tool-host -connect 127.0.0.1:7788 -name container -cwd /workspace/bob
prigh-docker: mode=web users: alice(10000,superuser) bob(10001); tool hosts: one per user, as that user; nix: daemon started
exec setpriv --reuid=1000 --regid=1000 --init-groups env -u PRIGH_TOKEN -u PRIGH_GH_TOKENS -u PRIGH_HOST_TOKENS -u GH_TOKEN -u PRIGH_TOKENS -u PRIGH_SUPERUSERS HOME=/home/prigh USER=prigh LOGNAME=prigh SHELL=/bin/bash NIX_REMOTE=daemon PATH=/home/prigh/.nix-profile/bin:/home/prigh/.local/state/nix/profile/bin:$PATH PRIGH_TOKENS=alice=tok-a\,bob=tok-b PRIGH_HOST_TOKENS=alice=host-token-alice\,bob=host-token-bob PRIGH_SUPERUSERS=alice prigh serve -cwd /workspace -no-backend-host -web 0.0.0.0:7788 -model m
--- /run/prigh/extrausers/passwd
alice:x:10000:10000:prigh user alice:/home/alice:/bin/bash
bob:x:10001:10001:prigh user bob:/home/bob:/bin/bash
--- /run/prigh/extrausers/group
alice:x:10000:
bob:x:10001:alice
--- /run/prigh/extrausers/shadow
alice:*:::::::
bob:*:::::::
--- dirs (mode owner path)
755 0 /home
700 10000 /home/alice
700 10001 /home/bob
700 1000 /home/prigh
755 0 /workspace
2770 10000 /workspace/alice
2770 10001 /workspace/bob
