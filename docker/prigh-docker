#!/usr/bin/env bash
# The container's entrypoint (see DOCKER.md). It starts as root, creates one
# Linux user per namespace and runs everything else without root: the backend
# as the prigh service user, each namespace's tool host as its own user. The
# exception is nix-daemon, which the users install tools through.
#
#   prigh-docker                            start what $PRIGH_MODE says
#   prigh-docker tui [ARGS]                 a TUI on the running server
#   prigh-docker as NAME CMD [ARGS]         run CMD as user NAME (or prigh)
#   prigh-docker login NAME PROVIDER [ARGS] log namespace NAME in to a provider
#   prigh-docker ssh-key [NAME]             create NAME's ~/.ssh/id_ed25519 if missing; print the public key
#   prigh-docker users                      list the users
#   prigh-docker nix-gc [keep|all|Nd]       collect Nix garbage now, first deleting old profile generations (default: PRIGH_NIX_GC_KEEP_DAYS)
#   prigh-docker healthcheck                exit 0 when every enabled port accepts connections
#   prigh-docker CMD [ARGS]                 run CMD as the prigh service user
#
# For docker/test-prigh-docker.sh: PRIGH_DOCKER_ROOT is prefixed to every
# path the script reads or writes, and PRIGH_DOCKER_DRY_RUN=1 prints the
# privileged steps (chown, setpriv, exec, the tool host loops, Nix) instead
# of running them, records ownership in $PRIGH_DOCKER_ROOT/owners and the
# valid store paths in $PRIGH_DOCKER_ROOT/nix/var/nix/db/valid, and pretends
# to be root (unless PRIGH_DOCKER_UID says otherwise). There the time is
# PRIGH_DOCKER_NOW, /nix's filesystem has $PRIGH_DOCKER_ROOT/fs-kib KiB, and
# Nix's garbage collector prints $PRIGH_DOCKER_ROOT/gc-output (and fails if
# $PRIGH_DOCKER_ROOT/gc-fails exists);
# `prigh-docker nix-gc-request LINE` handles one line the way the Nix GC
# helper does.
set -euo pipefail
shopt -s nullglob

root="${PRIGH_DOCKER_ROOT:-}"
dry_run="${PRIGH_DOCKER_DRY_RUN:-}"
if [ -n "$dry_run" ]; then
	my_uid="${PRIGH_DOCKER_UID:-0}"
else
	my_uid=$(id -u)
fi
mode="${PRIGH_MODE:-web}"
web_port=7790
server_port=7777
state=/run/prigh
extrausers="$state/extrausers"
users_file="$state/users"
min_uid=10000
service_user=prigh
user_shell=/bin/bash
nix_seed=/opt/nix-seed
nix_seed_stamp=/nix/var/prigh/seed
nix_roots=/nix/var/nix/gcroots/prigh
nix_socket=/nix/var/nix/daemon-socket/socket
nix_conf="$state/nix.conf"
nix_gc_dir="$state/nix-gc"
nix_gc_last=/nix/var/prigh/last-gc
nix_gc_scheduled=/nix/var/prigh/last-scheduled-gc

die() {
	echo "prigh-docker: $*" >&2
	exit 2
}

log() {
	echo "prigh-docker: $*" >&2
}

trim() {
	local s="$1"
	s="${s#"${s%%[![:space:]]*}"}"
	printf '%s' "${s%"${s##*[![:space:]]}"}"
}

now() {
	if [ -n "$dry_run" ]; then echo "${PRIGH_DOCKER_NOW:-1700000000}"; else date +%s; fi
}

# --- Privileged steps (stubbed by PRIGH_DOCKER_DRY_RUN) -----------------------

show() {
	local prefix="$1" a out=()
	shift
	for a in "$@"; do
		out+=("$(printf '%q' "${a#"$root"}")")
	done
	echo "$prefix ${out[*]}"
}

run() {
	if [ -n "$dry_run" ]; then show + "$@"; else "$@"; fi
}

run_exec() {
	if [ -n "$dry_run" ]; then
		show exec "$@"
		exit 0
	fi
	exec "$@"
}

owner_of() {
	if [ -n "$dry_run" ]; then
		awk -v p="${1#"$root"}" '$1 == p { u = $2 } END { print (u == "" ? 0 : u) }' "$root/owners" 2>/dev/null || echo 0
	else
		stat -c %u -- "$1"
	fi
}

mode_of() {
	stat -c %a -- "$1"
}

# set_owner [-R] UID PATH (the group is the uid too)
set_owner() {
	local opts=()
	if [ "$1" = -R ]; then
		opts=(-R)
		shift
	fi
	if [ -n "$dry_run" ]; then
		show + chown "${opts[@]}" "$1:$1" "$2"
		echo "${2#"$root"} $1" >>"$root/owners"
	else
		chown "${opts[@]}" "$1:$1" -- "$2"
	fi
}

set_mode() {
	[ "$(mode_of "$2")" = "$1" ] && return 0
	if [ -n "$dry_run" ]; then show + chmod "$1" "$2"; fi
	chmod "$1" -- "$2"
}

# --- PRIGH_MODE ---------------------------------------------------------------

# Parallel arrays of serve flags and ports.
flags=()
ports=()
tui_mode=false
IFS=',' read -ra entries <<<"${mode//[[:space:]]/}"
for m in "${entries[@]}"; do
	case "$m" in
	web) flags+=(-web) ports+=("$web_port") ;;
	server) flags+=(-listen) ports+=("$server_port") ;;
	tui) tui_mode=true ;;
	"") ;;
	prigh-web) die "PRIGH_MODE=prigh-web is now PRIGH_MODE=web (prigh-web on port $web_port)" ;;
	pi-web) die "pi-web was removed: use PRIGH_MODE=web (prigh-web on port $web_port)" ;;
	*) die "unknown PRIGH_MODE entry '$m' (expected web, server or tui)" ;;
	esac
done
if $tui_mode && [ ${#flags[@]} -gt 0 ]; then
	die "PRIGH_MODE=tui cannot be combined with other modes"
fi

# The JSON-lines port that tool hosts and `prigh-docker tui` connect to: the
# web port serves JSON lines too.
internal_port=""
for i in "${!flags[@]}"; do
	case "${flags[$i]}" in
	-listen) internal_port="${ports[$i]}" ;;
	-web) [ -n "$internal_port" ] || internal_port="${ports[$i]}" ;;
	esac
done

extra_args=()
if [ -n "${PRIGH_ARGS:-}" ]; then
	read -ra extra_args <<<"$PRIGH_ARGS"
fi

no_backend_host=false
[ "${PRIGH_NO_BACKEND_HOST:-}" = 1 ] && no_backend_host=true

# --- Users --------------------------------------------------------------------

# parse_pairs WHAT SPEC: NAME=VALUE,... into pair_names / pair_values.
parse_pairs() {
	local what="$1" entry name i=0
	local -a raw
	pair_names=()
	pair_values=()
	IFS=',' read -ra raw <<<"$2"
	for entry in "${raw[@]}"; do
		entry=$(trim "$entry")
		[ -n "$entry" ] || continue
		i=$((i + 1))
		[[ $entry == *=* ]] || die "$what: entry $i must be NAME=VALUE"
		name=$(trim "${entry%%=*}")
		pair_names+=("$name")
		pair_values+=("$(trim "${entry#*=}")")
		[ -n "${pair_values[-1]}" ] || die "$what: empty value for '$name'"
	done
}

declare -A system_names=() system_ids=()
read_system_accounts() {
	local name id file
	for file in "$root/etc/passwd" "$root/etc/group"; do
		while IFS=: read -r name _ id _; do
			[ -n "$name" ] || continue
			system_names[$name]=1
			system_ids[$id]=1
		done <"$file"
	done
}

check_user_name() {
	[[ $1 =~ ^[A-Za-z_][A-Za-z0-9_-]*$ ]] ||
		die "'$1' cannot be a user name: use letters, digits, _ and -, not starting with a digit or -"
	[ ${#1} -le 32 ] || die "user name '$1' is longer than 32 characters"
	[ -z "${system_names[$1]:-}" ] ||
		die "user name '$1' is taken by a system user or group of the image; choose another namespace name"
}

# users (in PRIGH_TOKENS order), user_tokens, superusers, auth (tokens|none).
declare -A user_tokens=() is_superuser=() gh_tokens=()
users=()
superusers=()
load_users() {
	local i name
	read_system_accounts
	if [ -n "${PRIGH_TOKENS:-}" ]; then
		[ -z "${PRIGH_TOKEN:-}" ] || log "PRIGH_TOKENS is set, ignoring PRIGH_TOKEN"
		parse_pairs PRIGH_TOKENS "$PRIGH_TOKENS"
		[ ${#pair_names[@]} -gt 0 ] || die "PRIGH_TOKENS has no NAME=TOKEN entries"
		for i in "${!pair_names[@]}"; do
			name="${pair_names[$i]}"
			check_user_name "$name"
			[ -z "${user_tokens[$name]:-}" ] || die "PRIGH_TOKENS: duplicate user '$name'"
			users+=("$name")
			user_tokens[$name]="${pair_values[$i]}"
		done
		auth=tokens
	elif [ -n "${PRIGH_TOKEN:-}" ]; then
		users=(default)
		user_tokens[default]="$PRIGH_TOKEN"
		auth=tokens
	elif [ "${PRIGH_ALLOW_NO_TOKEN:-}" = 1 ]; then
		users=(default)
		auth=none
	else
		die "set PRIGH_TOKEN or PRIGH_TOKENS (anyone who can reach the port can use prigh); PRIGH_ALLOW_NO_TOKEN=1 to skip"
	fi
	local -a names
	IFS=',' read -ra names <<<"${PRIGH_SUPERUSERS:-}"
	for name in "${names[@]}"; do
		name=$(trim "$name")
		[ -n "$name" ] || continue
		[ "$auth" = tokens ] || die "PRIGH_SUPERUSERS needs PRIGH_TOKEN or PRIGH_TOKENS"
		[ -n "${user_tokens[$name]:-}" ] || die "PRIGH_SUPERUSERS: '$name' is not a user from PRIGH_TOKENS"
		[ -n "${is_superuser[$name]:-}" ] || superusers+=("$name")
		is_superuser[$name]=1
	done
	load_gh_tokens
	for name in "${!gh_tokens[@]}"; do
		[[ " ${users[*]} " == *" $name "* ]] || die "PRIGH_GH_TOKENS: '$name' is not a user"
	done
}

load_gh_tokens() {
	local i
	parse_pairs PRIGH_GH_TOKENS "${PRIGH_GH_TOKENS:-}"
	for i in "${!pair_names[@]}"; do
		gh_tokens[${pair_names[$i]}]="${pair_values[$i]}"
	done
}

# Stable uids: a user keeps the owner of its home when that is >= min_uid;
# others get the lowest uid that no system account, home or other user has.
declare -A uid_of=()
allocate_uids() {
	local name dir uid next="$min_uid"
	local -A claimed=() used=()
	for dir in "$root"/home/*; do
		[ -d "$dir" ] || continue
		uid=$(owner_of "$dir")
		[ "$uid" -lt "$min_uid" ] || claimed[$uid]=1
	done
	local -a sorted
	mapfile -t sorted < <(printf '%s\n' "${users[@]}" | LC_ALL=C sort)
	for name in "${sorted[@]}"; do
		dir="$root/home/$name"
		[ -d "$dir" ] || continue
		uid=$(owner_of "$dir")
		if [ "$uid" -ge "$min_uid" ] && [ -z "${system_ids[$uid]:-}${used[$uid]:-}" ]; then
			uid_of[$name]="$uid"
			used[$uid]=1
		fi
	done
	for name in "${sorted[@]}"; do
		[ -z "${uid_of[$name]:-}" ] || continue
		while [ -n "${system_ids[$next]:-}${claimed[$next]:-}${used[$next]:-}" ]; do
			next=$((next + 1))
		done
		uid_of[$name]="$next"
		used[$next]=1
	done
}

write_accounts() {
	local dir="$root$extrausers" name
	mkdir -p "$dir"
	chmod 755 "$root$state" "$dir"
	: >"$dir/passwd"
	: >"$dir/group"
	(umask 077 && : >"$dir/shadow")
	: >"$root$users_file"
	for name in "${users[@]}"; do
		echo "$name:x:${uid_of[$name]}:${uid_of[$name]}:prigh user $name:/home/$name:$user_shell" >>"$dir/passwd"
		echo "$name:x:${uid_of[$name]}:" >>"$dir/group"
		echo "$name:*:::::::" >>"$dir/shadow"
		printf '%s\t%s\t%s\n' "$name" "${uid_of[$name]}" "${is_superuser[$name]:+yes}" >>"$root$users_file"
	done
}

require_accounts() {
	[ -f "$root$users_file" ] ||
		die "no users are set up ($users_file is missing): is the container running (through its entrypoint, in a network mode)?"
}

# lookup_user NAME: u_uid, u_home of a container user or prigh.
lookup_user() {
	local line file="$root$extrausers/passwd"
	if [ "$1" = "$service_user" ]; then
		file="$root/etc/passwd"
	else
		require_accounts
	fi
	line=$(awk -F: -v n="$1" '$1 == n' "$file")
	[ -n "$line" ] || die "no user '$1' (see prigh-docker users)"
	IFS=: read -r _ _ u_uid _ _ u_home _ <<<"$line"
}

# --- Environments and privilege dropping --------------------------------------

# nix_env HOME: the variables that let a user run nix through the daemon and
# the tools it installs in its profile, into nix_vars.
nix_env() {
	nix_vars=(NIX_REMOTE=daemon PATH="$1/.nix-profile/bin:$1/.local/state/nix/profile/bin:$PATH")
}

# user_env NAME: a clean environment for NAME into env_vars.
user_env() {
	nix_env "$u_home"
	env_vars=(HOME="$u_home" USER="$1" LOGNAME="$1" SHELL="$user_shell" "${nix_vars[@]}"
		LANG="${LANG:-C.UTF-8}" GIT_TERMINAL_PROMPT=0)
	# Bash sets an unexported TERM=dumb when there is none.
	[[ "$(declare -p TERM 2>/dev/null)" != "declare -x"* ]] || env_vars+=(TERM="$TERM")
	if [ "$1" = "$service_user" ]; then
		local v
		for v in PRIGH_BACKEND PRIGH_WEB_ROOT; do
			[ -z "${!v:-}" ] || env_vars+=("$v=${!v}")
		done
	else
		[ ${#gh_tokens[@]} -gt 0 ] || load_gh_tokens
		local gh="${gh_tokens[$1]:-${GH_TOKEN:-}}"
		[ -z "$gh" ] || env_vars+=(GH_TOKEN="$gh")
	fi
}

# as_user NAME: the command prefix that runs a program as NAME, into as_prefix.
as_user() {
	lookup_user "$1"
	if [ "$my_uid" = "$u_uid" ]; then
		as_prefix=()
	elif [ "$my_uid" = 0 ]; then
		as_prefix=(setpriv --reuid="$u_uid" --regid="$u_uid" --init-groups)
	else
		die "must run as root (or as $1) to run commands as $1"
	fi
}

# clean NAME [VAR=VALUE]... CMD...: CMD as NAME in NAME's clean environment,
# into cmd.
clean() {
	as_user "$1"
	user_env "$1"
	shift
	cmd=("${as_prefix[@]}" env -i "${env_vars[@]}" "$@")
}

# service [-u VAR]... [VAR=VALUE]... CMD...: CMD as prigh in the container's
# environment minus the per-user secrets, into cmd.
service() {
	as_user "$service_user"
	local unset=(-u PRIGH_TOKEN -u PRIGH_GH_TOKENS -u PRIGH_HOST_TOKENS)
	while [ "${1:-}" = -u ]; do
		unset+=(-u "$2")
		shift 2
	done
	nix_env "$u_home"
	cmd=("${as_prefix[@]}" env "${unset[@]}"
		HOME="$u_home" USER="$service_user" LOGNAME="$service_user" SHELL="$user_shell" "${nix_vars[@]}" "$@")
}

require_root() {
	[ "$my_uid" = 0 ] ||
		die "the container must start as root (uid $my_uid now): it creates a Linux user per namespace and then drops privileges itself; remove \`user:\`/--user"
}

# --- Directories --------------------------------------------------------------

# Old layout: the volume (now at /home) was prigh's home itself.
migrate_home() {
	local h="$root/home" tmp="$root/home/.prigh-migrating" e
	[ -e "$h/.prigh" ] || [ -e "$h/.config" ] || [ -d "$tmp" ] || return 0
	[ ! -e "$h/prigh" ] ||
		die "/home has both an old-layout home (.prigh or .config) and /home/prigh; move the old files into /home/prigh by hand"
	log "moving the old home volume's contents (prigh's home) into /home/prigh"
	mkdir -p "$tmp"
	for e in "$h"/* "$h"/.[!.]* "$h"/..?*; do
		[ "$e" = "$tmp" ] || mv -- "$e" "$tmp/"
	done
	mv -- "$tmp" "$h/prigh"
}

# ensure_home NAME UID: /home/NAME owned by UID:UID with mode 700; an existing
# one owned by someone else is chowned recursively.
ensure_home() {
	local dir="$root/home/$1" uid="$2"
	[ ! -L "$dir" ] || die "${dir#"$root"} is a symlink"
	if [ ! -e "$dir" ]; then
		mkdir -p "$dir"
		cp -a "$root/etc/skel/." "$dir/"
		set_owner -R "$uid" "$dir"
	elif [ "$(owner_of "$dir")" != "$uid" ]; then
		log "${dir#"$root"} is owned by uid $(owner_of "$dir"), not $uid: chowning it recursively"
		set_owner -R "$uid" "$dir"
	fi
	set_mode 700 "$dir"
}

setup_service_home() {
	local h="$root/home"
	mkdir -p "$h"
	migrate_home
	if [ "$(owner_of "$h")" != 0 ]; then set_owner 0 "$h"; fi
	set_mode 755 "$h"
	lookup_user "$service_user"
	ensure_home "$service_user" "$u_uid"
}

# Older images kept the projects in /workspace/<name>, now the users work in
# their homes: say how to move what is still bound there.
warn_old_workspace() {
	local d name to
	for d in "$root"/workspace/*; do
		[ -d "$d" ] || continue
		name="${d##*/}"
		if [[ " $* " == *" $name "* ]]; then
			to="cp -a /workspace/$name/. /home/$name/ && chown -R $name: /home/$name"
		else
			to="cp -a /workspace/$name /home/NAME/ && chown -R NAME: /home/NAME/$name"
		fi
		log "/workspace/$name is from an older image: users now work in their homes and nothing uses /workspace. Move it: docker compose exec prigh sh -c '$to', then remove the /workspace mount (see DOCKER.md, Migrating from /workspace)"
	done
}

# Run as NAME, so that it neither overrides the user's own config nor leaves
# root-owned files behind.
git_defaults() {
	[ -n "${PRIGH_GIT_NAME:-}${PRIGH_GIT_EMAIL:-}" ] || return 0
	# shellcheck disable=SC2016
	clean "$1" sh -c 'for kv in "user.name=$1" "user.email=$2"; do
  [ -z "${kv#*=}" ] || git config --global --get "${kv%%=*}" >/dev/null || git config --global "${kv%%=*}" "${kv#*=}"
done' sh "${PRIGH_GIT_NAME:-}" "${PRIGH_GIT_EMAIL:-}"
	run "${cmd[@]}"
}

random_token() {
	if [ -n "$dry_run" ]; then
		echo "host-token-$1"
	else
		od -An -tx1 -N32 /dev/urandom | tr -d ' \n'
	fi
}

# supervise NAME CMD...: CMD in NAME's home in the background, restarted
# whenever it exits.
supervise() {
	local name="$1"
	shift
	if [ -n "$dry_run" ]; then
		show "supervise in /home/$name:" "$@"
		return
	fi
	(
		cd "$root/home/$name"
		while :; do
			"$@" </dev/null && status=0 || status=$?
			log "tool host of $name exited ($status), restarting"
			sleep 2
		done
	) &
}

# --- Nix ----------------------------------------------------------------------

# nix_root_env: the environment of root's Nix processes, into nix_root_vars:
# none of the container's secrets, the local store, and caches on /nix since
# root's home is read-only.
nix_root_env() {
	local v
	nix_root_vars=(PATH="$PATH" LANG="${LANG:-C.UTF-8}" HOME=/root XDG_CACHE_HOME=/nix/var/cache/root)
	for v in http_proxy https_proxy ftp_proxy all_proxy no_proxy HTTP_PROXY HTTPS_PROXY FTP_PROXY ALL_PROXY NO_PROXY; do
		[ -z "${!v:-}" ] || nix_root_vars+=("$v=${!v}")
	done
}

# store_invalid PATH...: those of the store paths that the Nix database does
# not have.
store_invalid() {
	if [ -n "$dry_run" ]; then
		echo "+ nix-store --check-validity --print-invalid <the $# paths in $nix_seed/store>" >&2
		local p
		for p in "$@"; do
			grep -qxF -- "$p" "$root/nix/var/nix/db/valid" 2>/dev/null || echo "$p"
		done
	else
		nix_root_env
		env -i "${nix_root_vars[@]}" nix-store --check-validity --print-invalid "$@"
	fi
}

load_seed_db() {
	if [ -n "$dry_run" ]; then
		echo "+ nix-store --load-db < $nix_seed/registration"
		local db="$root/nix/var/nix/db/valid" p
		mkdir -p "${db%/*}"
		touch "$db"
		for p in "$root$nix_seed"/store/*; do
			echo "/nix/store/${p##*/}"
		done | LC_ALL=C sort -u -o "$db" - "$db"
	else
		nix_root_env
		env -i "${nix_root_vars[@]}" nix-store --load-db <"$nix_seed/registration"
	fi
}

# Atomically, so that an interrupted copy is never mistaken for a whole one.
copy_store_path() {
	local tmp="$root/nix/store/.prigh-seed-$1"
	rm -rf "$tmp"
	cp -a "$root$nix_seed/store/$1" "$tmp"
	mv "$tmp" "$root/nix/store/$1"
}

# The image's store paths (prigh's runtime and nix) go into the /nix volume,
# which hides the image's /nix: those missing are copied and registered, and
# GC roots keep them. Roots of an older image are dropped, so that the garbage
# collector can reclaim what only it used.
seed_nix() {
	local seed="$root$nix_seed" store="$root/nix/store" p base
	local paths=() copied=() invalid=()
	[ -d "$seed/store" ] || die "the image has no Nix seed ($nix_seed): prigh cannot run"
	mkdir -p "$store"
	rm -rf "$store"/.prigh-seed-*
	for p in "$seed"/store/*; do
		base="${p##*/}"
		paths+=("/nix/store/$base")
		if [ ! -e "$store/$base" ]; then
			copy_store_path "$base"
			copied+=("$base")
		fi
	done
	mapfile -t invalid < <(store_invalid "${paths[@]}")
	for p in "${invalid[@]}"; do
		base="${p##*/}"
		if [[ " ${copied[*]} " != *" $base "* ]]; then
			log "$p is in the store but not registered: replacing it with the image's copy"
			rm -rf "${store:?}/$base"
			copy_store_path "$base"
		fi
	done
	if [ ${#invalid[@]} -gt 0 ]; then
		log "adding the image's store paths to /nix (${#invalid[@]} missing or unregistered)"
		load_seed_db
	fi
	rm -rf "$root$nix_roots"
	mkdir -p "$root$nix_roots"
	while read -r p; do
		ln -s "$p" "$root$nix_roots/${p##*/}"
	done <"$seed/roots"
	mkdir -p "$root${nix_seed_stamp%/*}" "$root/nix/var/cache/root"
	cp "$seed/id" "$root$nix_seed_stamp"
}

# For commands other than start: a new container (docker compose run) may be
# the first to use the volume.
ensure_seeded() {
	[ "$my_uid" = 0 ] || return 0
	cmp -s "$root$nix_seed/id" "$root$nix_seed_stamp" || seed_nix
}

# nix-daemon as root in the background, restarted unless it keeps failing. A
# failure leaves prigh running, just without nix for the users. Sets
# nix_status for the summary.
start_nix_daemon() {
	local sock="$root$nix_socket" i
	nix_root_env
	# --quiet: no log line per connection.
	local daemon=(env -i "${nix_root_vars[@]}" nix-daemon --quiet)
	if [ -n "$dry_run" ]; then
		show "supervise nix-daemon:" "${daemon[@]}"
		nix_status="daemon started"
		return
	fi
	rm -f "$sock"
	(
		fails=0
		while :; do
			started=$SECONDS
			"${daemon[@]}" </dev/null && status=0 || status=$?
			if [ $((SECONDS - started)) -lt 10 ]; then fails=$((fails + 1)); else fails=0; fi
			if [ "$fails" -ge 3 ]; then
				log "nix-daemon exited ($status) 3 times in a row soon after starting: giving up, nix is unavailable to the users"
				exit 0
			fi
			log "nix-daemon exited ($status), restarting"
			sleep 2
		done
	) &
	for i in $(seq 50); do
		[ ! -S "$sock" ] || break
		sleep 0.1
	done
	if [ -S "$sock" ]; then
		nix_status="daemon running"
	else
		nix_status="NOT RUNNING, users cannot install tools (see the nix-daemon messages above)"
		log "nix-daemon has not created $nix_socket after 5 s"
	fi
}

# --- Nix garbage collection ---------------------------------------------------

# parse_interval VALUE: seconds (0 = off) from 0, off, or N with s, m, h or d.
parse_interval() {
	case "$1" in
	0 | off) echo 0 ;;
	*s) echo $((10#${1%s})) ;;
	*m) echo $((10#${1%m} * 60)) ;;
	*h) echo $((10#${1%h} * 3600)) ;;
	*d) echo $((10#${1%d} * 86400)) ;;
	esac
}

# parse_size VALUE FS_BYTES: bytes from a size as nix.conf takes it (a
# number with an optional K, M, G or T suffix, powers of 1024) or N% of
# FS_BYTES; empty if VALUE is neither.
parse_size() {
	local v="$1" n m=1
	if [[ $v =~ ^([0-9]{1,3})%$ ]]; then
		n=$((10#${BASH_REMATCH[1]}))
		[ "$n" -le 100 ] && echo $(($2 * n / 100))
		return 0
	fi
	[[ $v =~ ^([0-9]{1,15})([KkMmGgTt]?)$ ]] || return 0
	n=$((10#${BASH_REMATCH[1]}))
	case "${BASH_REMATCH[2]}" in
	[Kk]) m=$((1 << 10)) ;;
	[Mm]) m=$((1 << 20)) ;;
	[Gg]) m=$((1 << 30)) ;;
	[Tt]) m=$((1 << 40)) ;;
	esac
	[ "$n" -le $(((1 << 62) / m)) ] && echo $((n * m))
	return 0
}

# Sets gc_interval (seconds, 0 = off) and gc_keep (Nd, all or keep) from
# PRIGH_NIX_GC_INTERVAL and PRIGH_NIX_GC_KEEP_DAYS, and gc_min_free and
# gc_max_free (bytes; Nix's min-free and max-free) from PRIGH_NIX_MIN_FREE
# and PRIGH_NIX_MAX_FREE. Their defaults, 15% and 30% of /nix's filesystem,
# are clamped to 1-50 GiB and 3-100 GiB; values that are set are used as
# given.
load_gc_settings() {
	local interval="${PRIGH_NIX_GC_INTERVAL:-12h}" keep="${PRIGH_NIX_GC_KEEP_DAYS:-7}"
	local min_free="${PRIGH_NIX_MIN_FREE:-}" max_free="${PRIGH_NIX_MAX_FREE:-}"
	local gib=$((1 << 30)) sizes="a number of bytes, optionally with K, M, G or T (e.g. 20G), or a percentage of /nix's filesystem (e.g. 20%)"
	[[ $interval =~ ^(0|off|[0-9]{1,6}[smhd])$ ]] ||
		die "PRIGH_NIX_GC_INTERVAL='$interval': use a number with s, m, h or d (e.g. 1d, 12h), or 0 to turn the scheduled garbage collection off"
	gc_interval_text="$interval"
	gc_interval=$(parse_interval "$interval")
	case "$keep" in
	off) gc_keep=keep ;;
	*)
		[[ $keep =~ ^[0-9]{1,5}$ ]] ||
			die "PRIGH_NIX_GC_KEEP_DAYS='$keep': use a number of days (0 deletes every old profile generation), or off to keep them all"
		if [ $((10#$keep)) = 0 ]; then gc_keep=all; else gc_keep="$((10#$keep))d"; fi
		;;
	esac
	gc_fs_bytes=$(($(fs_kib "$root/nix") * 1024))
	if [ -n "$min_free" ]; then
		gc_min_free=$(parse_size "$min_free" "$gc_fs_bytes")
		[ -n "$gc_min_free" ] ||
			die "PRIGH_NIX_MIN_FREE='$min_free': use $sizes, or 0 to turn off collecting while Nix builds"
	else
		gc_min_free=$(clamp $((gc_fs_bytes * 15 / 100)) "$gib" $((50 * gib)))
	fi
	if [ -n "$max_free" ]; then
		gc_max_free=$(parse_size "$max_free" "$gc_fs_bytes")
		[ -n "$gc_max_free" ] || die "PRIGH_NIX_MAX_FREE='$max_free': use $sizes"
		[ "$gc_min_free" = 0 ] || [ "$gc_max_free" -gt "$gc_min_free" ] ||
			die "PRIGH_NIX_MAX_FREE='$max_free' ($(human "$gc_max_free")) must be more than PRIGH_NIX_MIN_FREE='${min_free:-15%}' ($(human "$gc_min_free")): Nix collects when less than min-free is free, until max-free is"
	else
		gc_max_free=$(clamp $((gc_fs_bytes * 30 / 100)) $((3 * gib)) $((100 * gib)))
		[ "$gc_max_free" -gt $((gc_min_free + gib)) ] || gc_max_free=$((gc_min_free + 2 * gib))
	fi
}

# fs_kib PATH: the size of PATH's filesystem in KiB.
fs_kib() {
	if [ -n "$dry_run" ]; then
		cat "$root/fs-kib" 2>/dev/null || echo 104857600
	else
		df -Pk -- "$1" | awk 'NR == 2 { print $2 }'
	fi
}

# clamp VALUE MIN MAX
clamp() {
	local v="$1"
	[ "$v" -ge "$2" ] || v="$2"
	[ "$v" -le "$3" ] || v="$3"
	echo "$v"
}

# /etc/nix/nix.conf includes this file: Nix collects garbage while it builds
# or fetches when less than gc_min_free bytes are free, until gc_max_free are.
write_nix_conf() {
	mkdir -p "$root$state"
	printf '%s\n' "# Written by prigh-docker at start, for the $(human "$gc_fs_bytes") filesystem of /nix" \
		"# (PRIGH_NIX_MIN_FREE=${PRIGH_NIX_MIN_FREE:-15%}, PRIGH_NIX_MAX_FREE=${PRIGH_NIX_MAX_FREE:-30%})." \
		"min-free = $gc_min_free" "max-free = $gc_max_free" >"$root$nix_conf"
	chmod 644 "$root$nix_conf"
	if [ "$gc_min_free" = 0 ]; then
		nix_gc_summary="none while Nix builds (PRIGH_NIX_MIN_FREE=0)"
	else
		nix_gc_summary="collects while Nix builds below $(human "$gc_min_free") free, up to $(human "$gc_max_free")"
	fi
}

# user_profiles NAME HOME: NAME's Nix profiles (not their generations).
user_profiles() {
	local p
	for p in "$root$2"/.local/state/nix/profiles/* "$root"/nix/var/nix/profiles/per-user/"$1"/*; do
		[ -L "$p" ] || continue
		[[ ${p##*/} =~ -[0-9]+-link$ ]] && continue
		echo "${p#"$root"}"
	done
}

# delete_generations GENS: the profile generations of every user (and prigh)
# older than GENS (Nd; all: all but the current one), as that user, so that
# nothing in their homes is touched as root.
delete_generations() {
	local arg name profile
	case "$1" in
	all) arg=old ;;
	*) arg="$1" ;;
	esac
	local -a names=("$service_user")
	if [ -f "$root$users_file" ]; then
		while IFS=$'\t' read -r name _; do names+=("$name"); done <"$root$users_file"
	fi
	for name in "${names[@]}"; do
		lookup_user "$name"
		while read -r profile; do
			echo "deleting old generations of $profile"
			clean "$name" nix-env --profile "$profile" --delete-generations "$arg"
			run "${cmd[@]}" || echo "could not delete the generations of $profile"
		done < <(user_profiles "$name" "$u_home")
	done
}

store_gc() {
	nix_root_env
	if [ -n "$dry_run" ]; then
		show + env -i "${nix_root_vars[@]}" nix store gc -v
		cat "$root/gc-output" 2>/dev/null || true
		[ ! -e "$root/gc-fails" ]
	else
		env -i "${nix_root_vars[@]}" nix store gc -v
	fi
}

# to_bytes NUMBER UNIT
to_bytes() {
	awk -v n="$1" -v u="$2" 'BEGIN {
		s = (u == "KiB") ? 1024 : (u == "MiB") ? 1048576 : (u == "GiB") ? 1073741824 : (u == "TiB") ? 1099511627776 : 1
		printf "%.0f\n", n * s }'
}

# human BYTES
human() {
	awk -v b="$1" 'BEGIN { split("B KiB MiB GiB TiB", u, " "); i = 1
		while (b >= 1024 && i < 5) { b /= 1024; i++ }
		printf (i == 1 ? "%d %s\n" : "%.1f %s\n"), b, u[i] }'
}

# write_fields FILE KEY=VALUE...: atomically, world-readable.
write_fields() {
	local file="$1"
	shift
	printf '%s\n' "$@" >"$file.tmp"
	chmod 644 "$file.tmp"
	mv -f -- "$file.tmp" "$file"
}

# nix_gc GENS BY LOG [RESULT]: deletes old profile generations (unless GENS is
# keep), collects garbage and records it as the last collection (also in
# RESULT for the backend). Nix's output goes to LOG.
nix_gc() {
	local gens="$1" by="$2" log_file="$3" result="${4:-}" dir="$root$nix_gc_dir"
	local started finished summary size unit deleted=0 freed=0 generations status=ok error=""
	mkdir -p "$dir" "$root${nix_gc_last%/*}"
	started=$(now)
	write_fields "$dir/running" "by=$by" "since=$started" "generations=$gens"
	{
		[ "$gens" = keep ] || delete_generations "$gens"
		echo "collecting garbage"
		store_gc || echo "nix store gc failed (exit $?)"
	} >>"$log_file" 2>&1
	generations=$(grep -c '^removing profile version ' "$log_file" || true)
	summary=$(grep -E '^[0-9]+ store paths? deleted, [0-9.]+ [KMGT]?i?B freed$' "$log_file" | tail -1 || true)
	if grep -q '^nix store gc failed' "$log_file"; then
		status=error
		error="nix store gc failed: $(grep -v '^nix store gc failed' "$log_file" | tail -1)"
	elif [ -n "$summary" ]; then
		read -r deleted _ _ _ size unit _ <<<"$summary"
		freed=$(to_bytes "$size" "$unit")
	fi
	finished=$(now)
	local fields=("at=$finished" "by=$by" "generations=$gens" "generations_deleted=$generations"
		"paths_deleted=$deleted" "freed_bytes=$freed" "seconds=$((finished - started))")
	if [ "$status" = ok ]; then
		write_fields "$root$nix_gc_last" "${fields[@]}"
		cp -f "$root$nix_gc_last" "$dir/last-gc"
		log "nix garbage collection (by $by): deleted $generations profile generations and $deleted store paths, freed $(human "$freed")"
	else
		log "nix garbage collection (by $by) failed: $error"
	fi
	[ -z "$result" ] || write_fields "$result" "status=$status" "error=$error" "${fields[@]}"
	rm -f "$dir/running"
}

# with_gc_lock CMD...: one collection at a time (the backend's, the
# schedule's and prigh-docker nix-gc's).
with_gc_lock() {
	if [ -n "$dry_run" ]; then
		"$@"
	else
		mkdir -p "$root$nix_gc_dir"
		(
			flock 9
			"$@"
		) 9>"$root$nix_gc_dir/lock"
	fi
}

# One line from the backend: gc ID GENS BY. Anything else is ignored.
nix_gc_request() {
	local dir="$root$nix_gc_dir" id gens by f
	if [[ $1 =~ ^gc\ ([a-z0-9]{1,32})\ (keep|all|[0-9]{1,5}d)\ ([A-Za-z_][A-Za-z0-9_-]{0,31})$ ]]; then
		id="${BASH_REMATCH[1]}" gens="${BASH_REMATCH[2]}" by="${BASH_REMATCH[3]}"
		for f in "$dir"/*.log "$dir"/*.result; do rm -f -- "$f"; done
		: >"$dir/$id.log"
		chmod 644 "$dir/$id.log"
		with_gc_lock nix_gc "$gens" "$by" "$dir/$id.log" "$dir/$id.result"
	else
		log "nix garbage collection: ignoring a malformed request (${#1} characters)"
	fi
}

write_gc_schedule() {
	local keep="${gc_keep%d}"
	case "$gc_keep" in
	keep) keep=off ;;
	all) keep=0 ;;
	esac
	write_fields "$root$nix_gc_dir/schedule" "interval=$gc_interval" "keep_days=$keep" "next_at=${1:-}"
}

# The root helper (see DOCKER.md, "Garbage collection"): serves the backend's
# requests from a FIFO that only prigh may write, and runs the scheduled
# collection every gc_interval (the first one at least 5 minutes after
# start), deleting the profile generations older than gc_keep.
start_nix_gc_helper() {
	local dir="$root$nix_gc_dir" fifo="$root$nix_gc_dir/requests" last now_s next=""
	load_gc_settings
	mkdir -p "$dir" "$root${nix_gc_scheduled%/*}"
	chmod 755 "$dir"
	rm -f "$fifo"
	mkfifo -m 600 "$fifo"
	if [ -n "$dry_run" ]; then show + chown "0:$service_user" "$fifo"; else chown "0:$service_user" "$fifo"; fi
	chmod 620 "$fifo"
	[ ! -f "$root$nix_gc_last" ] || cp -f "$root$nix_gc_last" "$dir/last-gc"
	now_s=$(now)
	[ -f "$root$nix_gc_scheduled" ] || echo "$now_s" >"$root$nix_gc_scheduled"
	if [ "$gc_interval" -gt 0 ]; then
		last=$(cat "$root$nix_gc_scheduled")
		next=$((last + gc_interval))
		[ "$next" -ge $((now_s + 300)) ] || next=$((now_s + 300))
		nix_gc_summary+=", and every $gc_interval_text"
		case "$gc_keep" in
		keep) nix_gc_summary+=" keeping all profile generations" ;;
		all) nix_gc_summary+=" deleting all old profile generations" ;;
		*) nix_gc_summary+=" deleting profile generations older than ${gc_keep%d} days" ;;
		esac
	else
		nix_gc_summary+=", none scheduled"
	fi
	write_gc_schedule "$next"
	if [ -n "$dry_run" ]; then
		echo "supervise nix-gc helper: requests from ${fifo#"$root"}, next scheduled collection at ${next:-never}"
		return
	fi
	(
		exec 3<>"$fifo"
		while :; do
			line=""
			if [ "$gc_interval" -gt 0 ]; then
				wait_s=$((next - $(now)))
				if [ "$wait_s" -le 0 ]; then
					: >"$dir/scheduled.log"
					with_gc_lock nix_gc "$gc_keep" schedule "$dir/scheduled.log"
					now >"$root$nix_gc_scheduled"
					next=$(($(now) + gc_interval))
					write_gc_schedule "$next"
					continue
				fi
				read -r -t "$wait_s" line <&3 || continue
			else
				read -r line <&3 || continue
			fi
			nix_gc_request "$line"
		done
	) </dev/null &
}

# --- Commands -----------------------------------------------------------------

start_tui_mode() {
	local cwd="${PRIGH_CWD:-/home/$service_user}"
	load_gc_settings
	setup_service_home
	warn_old_workspace "$service_user"
	seed_nix
	write_nix_conf
	start_nix_daemon
	start_nix_gc_helper
	lookup_user "$service_user"
	local prigh_uid="$u_uid"
	if [ ! -e "$root$cwd" ]; then
		mkdir -p "$root$cwd"
		set_owner "$prigh_uid" "$root$cwd"
	fi
	git_defaults "$service_user"
	[ -n "$dry_run" ] || [ -t 0 ] ||
		die "PRIGH_MODE=tui needs a terminal: run with -it (compose: stdin_open + tty) and attach"
	local tui_args=()
	if [ -n "${PRIGH_TUI_ARGS:-}" ]; then
		read -ra tui_args <<<"$PRIGH_TUI_ARGS"
	fi
	cd "$root$cwd"
	service prigh-tui -cwd "$cwd" "${tui_args[@]}" -- "${extra_args[@]}"
	log "mode=tui cwd=$cwd (single user: tools run as $service_user); nix: $nix_status; garbage: $nix_gc_summary"
	run_exec "${cmd[@]}"
}

start() {
	require_root
	if $tui_mode; then
		start_tui_mode
	fi
	[ ${#flags[@]} -gt 0 ] || die "PRIGH_MODE='$mode' enables nothing"
	load_gc_settings
	load_users
	setup_service_home
	allocate_uids
	write_accounts
	local name
	for name in "${users[@]}"; do
		ensure_home "$name" "${uid_of[$name]}"
	done
	warn_old_workspace "${users[@]}"
	seed_nix
	write_nix_conf
	start_nix_daemon
	start_nix_gc_helper

	local host_tokens=() summary=() hello
	for name in "${users[@]}"; do
		summary+=("$name(${uid_of[$name]}${is_superuser[$name]:+,superuser})")
		git_defaults "$name"
	done
	if ! $no_backend_host; then
		for name in "${users[@]}"; do
			hello=()
			if [ "$auth" = tokens ]; then
				local token
				token=$(random_token "$name")
				host_tokens+=("$name=$token")
				hello=(PRIGH_TOKEN="$token" PRIGH_USER="$name")
			fi
			clean "$name" "${hello[@]}" \
				prigh tool-host -connect "127.0.0.1:$internal_port" -name container -host-id "container-$name" -cwd "/home/$name"
			supervise "$name" "${cmd[@]}"
		done
	fi

	local serve_args=(-cwd "/home/$service_user" -no-backend-host) i
	for i in "${!flags[@]}"; do
		serve_args+=("${flags[$i]}" "0.0.0.0:${ports[$i]}")
	done
	local backend_env=(-u GH_TOKEN -u PRIGH_TOKENS -u PRIGH_SUPERUSERS PRIGH_NIX_GC_HELPER="$nix_gc_dir")
	if [ "$auth" = tokens ]; then
		local specs=()
		for name in "${users[@]}"; do
			specs+=("$name=${user_tokens[$name]}")
		done
		backend_env+=("PRIGH_TOKENS=$(
			IFS=,
			echo "${specs[*]}"
		)")
	fi
	if [ ${#host_tokens[@]} -gt 0 ]; then
		backend_env+=("PRIGH_HOST_TOKENS=$(
			IFS=,
			echo "${host_tokens[*]}"
		)")
	fi
	if [ ${#superusers[@]} -gt 0 ]; then
		backend_env+=("PRIGH_SUPERUSERS=$(
			IFS=,
			echo "${superusers[*]}"
		)")
	fi
	local hosts="one per user, as that user"
	! $no_backend_host || hosts="none in the container (PRIGH_NO_BACKEND_HOST=1)"
	log "mode=$mode users: ${summary[*]}; tool hosts: $hosts; nix: $nix_status; garbage: $nix_gc_summary"
	cd "$root/home/$service_user"
	service "${backend_env[@]}" prigh serve "${serve_args[@]}" "${extra_args[@]}"
	run_exec "${cmd[@]}"
}

tui() {
	local a prev="" tools=(-tools remote)
	for a in "$@"; do
		if [ "$prev" = -tools ]; then
			[ "$a" != local ] ||
				die "-tools local would run the agent's tools as the $service_user service user, which can read every namespace's logins; use the container's tool hosts (the default), or run a TUI as a user: prigh-docker as NAME prigh-tui -connect 127.0.0.1:${internal_port:-$web_port} -user NAME -token TOKEN -tools local"
			tools=()
		fi
		prev="$a"
	done
	if $tui_mode; then
		service prigh-tui -cwd "${PRIGH_CWD:-/home/$service_user}" "$@" -- "${extra_args[@]}"
		run_exec "${cmd[@]}"
	fi
	local token_env=()
	if [ -z "${PRIGH_TOKENS:-}" ] && [ -n "${PRIGH_TOKEN:-}" ]; then
		token_env=(PRIGH_TOKEN="$PRIGH_TOKEN")
	fi
	clean "$service_user" "${token_env[@]}" prigh-tui -connect "127.0.0.1:$internal_port" "${tools[@]}" "$@"
	run_exec "${cmd[@]}"
}

as() {
	[ $# -ge 2 ] || die "usage: prigh-docker as NAME CMD [ARGS]"
	clean "$@"
	run_exec "${cmd[@]}"
}

login() {
	[ $# -ge 2 ] || die "usage: prigh-docker login NAME PROVIDER [ARGS]"
	local name="$1" dir
	shift
	if $tui_mode; then
		[ "$name" = default ] || die "PRIGH_MODE=tui has only the namespace default"
	else
		lookup_user "$name"
	fi
	if [ "$name" = default ]; then
		dir="/home/$service_user/.config/prigh"
	else
		dir="/home/$service_user/.prigh/namespaces/$name/.config/prigh"
	fi
	clean "$service_user" mkdir -p "$dir"
	run "${cmd[@]}"
	clean "$service_user" prigh login -auth-file "$dir/auth.json" "$@"
	run_exec "${cmd[@]}"
}

ssh_key() {
	local name="${1:-}"
	if [ -z "$name" ]; then
		if $tui_mode; then
			name="$service_user"
		else
			require_accounts
			local -a names
			mapfile -t names < <(cut -f1 "$root$users_file")
			[ ${#names[@]} -eq 1 ] || die "several users (${names[*]}): prigh-docker ssh-key NAME"
			name="${names[0]}"
		fi
	fi
	# shellcheck disable=SC2016
	clean "$name" sh -c 'key="$HOME/.ssh/id_ed25519"
if [ ! -f "$key" ]; then
  mkdir -p "$HOME/.ssh" && chmod 700 "$HOME/.ssh" && ssh-keygen -q -t ed25519 -N "" -C "$1" -f "$key"
fi
cat "$key.pub"' sh "$name@prigh"
	run_exec "${cmd[@]}"
}

list_users() {
	require_accounts
	local name uid su
	printf '%-16s %-6s %-22s %s\n' NAME UID HOME SUPERUSER
	while IFS=$'\t' read -r name uid su; do
		printf '%-16s %-6s %-22s %s\n' "$name" "$uid" "/home/$name" "${su:-no}"
	done <"$root$users_file"
}

nix_gc_now() {
	[ "$my_uid" = 0 ] || die "nix-gc needs root: docker compose exec prigh prigh-docker nix-gc"
	load_gc_settings
	local gens="${1:-$gc_keep}" log_file="$root$nix_gc_dir/console.log"
	[[ $gens =~ ^(keep|all|[0-9]{1,5}d)$ ]] ||
		die "usage: prigh-docker nix-gc [keep|all|Nd] (keep: no profile generations, all: all but the current ones, Nd: those older than N days; default: PRIGH_NIX_GC_KEEP_DAYS)"
	mkdir -p "$root$nix_gc_dir"
	: >"$log_file"
	with_gc_lock nix_gc "$gens" console "$log_file"
	cat "$log_file"
}

port_open() {
	(exec 3<>"/dev/tcp/127.0.0.1/$1") 2>/dev/null
}

healthcheck() {
	local i
	for i in "${!flags[@]}"; do
		port_open "${ports[$i]}" || {
			echo "port ${ports[$i]} (${flags[$i]}) is not accepting connections" >&2
			exit 1
		}
	done
}

case "${1:-}" in
"" | start) start ;;
tui)
	shift
	ensure_seeded
	tui "$@"
	;;
as)
	shift
	ensure_seeded
	as "$@"
	;;
login)
	shift
	ensure_seeded
	login "$@"
	;;
ssh-key)
	shift
	ssh_key "$@"
	;;
users) list_users ;;
nix-gc)
	shift
	nix_gc_now "$@"
	;;
nix-gc-request)
	[ -n "$dry_run" ] || die "nix-gc-request is for tests"
	nix_gc_request "${2:-}"
	;;
healthcheck) healthcheck ;;
*)
	if [ "$my_uid" != 0 ]; then
		run_exec "$@"
	fi
	ensure_seeded
	clean "$service_user" "$@"
	run_exec "${cmd[@]}"
	;;
esac
