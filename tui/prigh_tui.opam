# This file is generated by dune, edit dune-project instead
opam-version: "2.0"
synopsis: "Bonsai_term frontend for the prigh agentic coding harness"
depends: [
  "ocaml"
  "dune" {>= "3.17"}
  "core"
  "core_unix"
  "async"
  "ppx_jane"
  "jsonaf"
  "bonsai"
  "bonsai_term"
  "bonsai_test"
  "expect_test_helpers_core"
  "expect_test_helpers_async"
  "re"
  "uucp"
  "odoc" {with-doc}
]
build: [
  ["dune" "subst"] {dev}
  [
    "dune"
    "build"
    "-p"
    name
    "-j"
    jobs
    "@install"
    "@runtest" {with-test}
    "@doc" {with-doc}
  ]
]
