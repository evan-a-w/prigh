; prigh-web: main.bc.js plus the page, assembled under site/ (what
; `prigh serve -prigh-web` serves). The dev profile compiles separately with
; inline source maps (~49 MB, quick to relink); release builds (`-p`, Nix)
; are whole-program (~1.4 MB).

(executable
 (name main)
 (modes js)
 (preprocess
  (pps ppx_jane js_of_ocaml-ppx))
 (js_of_ocaml
  (flags
   (:standard --opt 3)))
 (libraries prigh_web_app))
