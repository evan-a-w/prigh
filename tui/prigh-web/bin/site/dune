(rule
 (target main.bc.js)
 (deps ../main.bc.js)
 (action
  (copy ../main.bc.js main.bc.js)))

(rule
 (target index.html)
 (deps ../index.html)
 (action
  (copy ../index.html index.html)))

(rule
 (target style.css)
 (deps ../style.css)
 (action
  (copy ../style.css style.css)))

(rule
 (target chat.css)
 (deps ../chat.css)
 (action
  (copy ../chat.css chat.css)))

(rule
 (target agents.css)
 (deps ../agents.css)
 (action
  (copy ../agents.css agents.css)))

(install
 (section share)
 (package prigh_tui)
 (files
  (index.html as prigh-web/index.html)
  (main.bc.js as prigh-web/main.bc.js)
  (style.css as prigh-web/style.css)
  (chat.css as prigh-web/chat.css)
  (agents.css as prigh-web/agents.css)))
